[Unit]
Description=CRM via e-mail - INF513 Grupo 05 SA (POP3 mail.tecnoweb.org.bo, SMTP smtp.gmail.com, PostgreSQL db.tecnoweb.org.bo)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=crmmail
Group=crmmail
WorkingDirectory=/opt/crm-mail
LogsDirectory=crm-mail
LogsDirectoryMode=0750
RuntimeDirectory=crm-mail
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/java -Duser.timezone=America/La_Paz -Dcrm.log.dir=/var/log/crm-mail -Dcrm.lock.dir=/run/crm-mail -Xmx256m -jar /opt/crm-mail/crm-mail.jar /etc/crm-mail/crm-mail.properties
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/crm-mail /run/crm-mail

[Install]
WantedBy=multi-user.target
